<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gameUI.controller.Help">
   <children>
      <ScrollPane fitToWidth="true" layoutX="0.0" layoutY="0.0" prefHeight="400.0" prefWidth="600.0">
         <content>
            <VBox spacing="10.0" prefWidth="580.0" style="-fx-padding: 16;">
               <children>
                  <Label text="游戏指引" style="-fx-font-size: 20px; -fx-font-weight: bold;" wrapText="true" />
                  <Label wrapText="true" text="这座孤岛曾是隐秘生物研究所，研究员改造野生动物的实验彻底失控，变异巨兽被封印在海岛灯塔。一场风暴摧毁撤离船只，幸存研究员四散逃亡，数块记载真相的灯塔碎片散落于岛屿四角。整座岛屿被研究所能量场笼罩，夜晚能量震荡产生的瘴气，会让岛上所有生灵陷入昏睡，待苏醒后便是全新的一天。玩家身份为一名007小厂程序员，原本乘坐轮船跨越大西洋，前去面见素未谋面的甲方。途中遭遇特大风暴，意外流落这座神秘荒岛，专属荒岛求生之旅就此开启。（点击鼠标开始游戏）" />
                  <Label text="核心目标" style="-fx-font-size: 16px; -fx-font-weight: bold;" wrapText="true" />
                  <Label wrapText="true" text="需在三十天内，收集散落在沙滩、丛林、岩地、海岸四大区域的20块灯塔碎片，点亮海岛灯塔，终结实验灾难，以此获取救援、成功离岛。若超过三十天，瘴气将彻底笼罩全岛，玩家会永久昏睡、葬身荒岛。死亡规则：玩家任意属性数值低于或超出限定范围，即刻死亡，永久滞留荒岛。" />
                  <Label text="基础生存机制" style="-fx-font-size: 16px; -fx-font-weight: bold;" wrapText="true" />
                  <Label wrapText="true" text="1. 每日基础：玩家每天固定拥有10个行动点，行动点耗尽后触发瘴气昏睡，当日无法继续行动。2. 跳过机制：可使用「装睡」技能（点击下一天按钮），直接跳转至第二天。3. 刷新规则：行动点不累计留存，次日自动刷新恢复为10点满值。4. 消耗数值：每进行一次行动，增加5点疲惫值、2点口渴值、2点饥饿值。5. 耗点行动（单次消耗1点行动点）：场景探索、原地休息（点击休息按钮）、道具、工具合成。" />
                  <Label wrapText="true" text="物资与背包系统：游戏内所有材料、食材、道具均可在背包内查看、管理。各类物资效果：猪肉：恢复30点血量；兔肉：减少22点饥饿值；椰子：减少20点口渴值；鱼肉：减少25点疲惫值。" />
                  <Label wrapText="true" text="工具合成系统（工作台）：可通过工作台消耗对应材料合成工具、武器，不同武器可提升不同数值武力值，具体合成配方如下：木棍：藤蔓×2 + 木头×3；贝刃：木棍×1 + 贝壳×3；石剑：木棍×2 + 矿石×5；斧头：木棍×1 + 矿石×3；锤子：木棍×1 + 矿石×3。" />
                  <Label wrapText="true" text="地图切换机制：点击地图按钮，可自由选择、切换任意已解锁地形场景。" />
                  <Label wrapText="true" text="探索系统：在当前场景点击探索按钮，即可开展区域探索，探索过程仅触发三类随机事件：无事发生、获取随机资源、遭遇野兽袭击。若触发野兽遭遇事件，将开启一局生死搏斗，单局定胜负，攻击数值更高者存活，野兽攻击值为随机刷新数值。" />
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </children>
</AnchorPane>
