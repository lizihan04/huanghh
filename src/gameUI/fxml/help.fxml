<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gameUI.controller.Help">
   <children>
      <ScrollPane fitToWidth="true" layoutX="0.0" layoutY="0.0" prefHeight="400.0" prefWidth="600.0">
         <content>
            <VBox spacing="10.0" prefWidth="580.0" style="-fx-padding: 16;">
               <children>
                  <Label text="游戏指引" style="-fx-font-size: 20px; -fx-font-weight: bold;" wrapText="true" />
                  <Label wrapText="true" text="这座孤岛曾是隐秘生物研究所，研究员改造野生动物的实验彻底失控，变异巨兽被封印在海岛灯塔。一场风暴摧毁撤离船只，幸存研究员四散逃亡，数块记载灾难真相的灯塔碎片散落于岛屿四角。整座岛屿被研究所遗留能量场笼罩，每到夜晚能量剧烈震荡滋生瘴气，岛上所有生灵都会陷入昏睡；等再次清醒，便是全新的一天。你是一名007小厂程序员，搭乘轮船横渡大西洋前去会面素未谋面的甲方，途中遭遇特大风暴，船只失事，你孤身漂流至这座诡异荒岛，你的绝境求生之旅正式开启。（点击鼠标即可开始游戏）" />
                  <Label text="核心目标" style="-fx-font-size: 16px; -fx-font-weight: bold;" wrapText="true" />
                  <Label wrapText="true" text="1. 时限要求：三十天内，集齐散落在沙滩、丛林、岩地、海岸四大区域的20块灯塔碎片。" />
                  <Label wrapText="true" text="2. 通关条件：集齐碎片点亮灯塔，彻底终结实验灾难，迎来外部救援。" />
                  <Label wrapText="true" text="3. 死亡惩罚：三十天期限一到，全岛会被瘴气彻底覆盖，玩家永久昏睡死亡；任意生存属性低于/超出安全阈值，也会直接死亡，永久滞留荒岛。" />
                  <Label text="基础生存机制" style="-fx-font-size: 16px; -fx-font-weight: bold;" wrapText="true" />
                  <Label wrapText="true" text="3.1 行动与天数重置机制" style="-fx-font-weight: bold;" />
                  <Label wrapText="true" text="1. 每日资源：玩家单日固定拥有10点行动点，行动点不可跨天累计，次日自动刷新回满10点。" />
                  <Label wrapText="true" text="2. 瘴气规则：当日行动消耗达到对应阈值，会强制触发夜间瘴气昏睡，无法继续执行任何操作。" />
                  <Label wrapText="true" text="3. 快速跳转技能：【装睡】，点击「下一天」按钮可直接跳过当日，进入新一天。" />
                  <Label wrapText="true" text="4. 消耗规则：每执行1次任意行动，增加5点疲惫值、2点口渴值、2点饥饿值。" />
                  <Label wrapText="true" text="5. 消耗1行动点的行为清单：① 区域探索 ② 原地休息（点击休息按钮） ③ 工作台合成工具。" />
                  <Label wrapText="true" text="3.2 物资与背包系统" style="-fx-font-weight: bold;" />
                  <Label wrapText="true" text="所有收集到的原材料、食物、道具全部统一展示在背包界面。" />
                  <Label wrapText="true" text="食物效果明细：猪肉：-30饥饿值、-10疲惫值、+15血量；兔肉：-20饥饿值、-10疲惫值、+10血量；椰子：-20口渴值、-10疲惫值；鱼肉：-20饥饿值、-10疲惫值、+10血量。" />
                  <Label wrapText="true" text="3.3 工作台·工具合成系统" style="-fx-font-weight: bold;" />
                  <Label wrapText="true" text="消耗材料合成各类工具/武器，不同武器会提供不等武力值加成。" />
                  <Label wrapText="true" text="1. 木棍 = 藤蔓×1 + 木头×2" />
                  <Label wrapText="true" text="2. 贝刃 = 木棍×1 + 贝壳×3" />
                  <Label wrapText="true" text="3. 石剑 = 木棍×1 + 矿石×2 + 石头×1" />
                  <Label wrapText="true" text="4. 斧头 = 木棍×1 + 矿石×2 + 石头×1" />
                  <Label wrapText="true" text="5. 锤子 = 木棍×1 + 矿石×2 + 石头×1" />
                  <Label wrapText="true" text="3.4 地图切换系统" style="-fx-font-weight: bold;" />
                  <Label wrapText="true" text="点击「地图」按钮，可自由选择前往沙滩、丛林、岩地、海岸任意地形。" />
                  <Label wrapText="true" text="3.5 区域探索系统" style="-fx-font-weight: bold;" />
                  <Label wrapText="true" text="选中地形后点击「探索」按钮，在当前区域展开搜寻，随机触发三类事件：" />
                  <Label wrapText="true" text="1. 无事发生，无任何收益与损耗。" />
                  <Label wrapText="true" text="2. 成功获取对应地形资源材料。" />
                  <Label wrapText="true" text="3. 遭遇野生变异野兽，触发生死搏斗。" />
                  <Label wrapText="true" text="野兽搏斗规则：一局定生死，对比双方攻击数值，数值更高者存活；野兽每次遭遇时攻击值随机刷新。" />
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </children>
</AnchorPane>
