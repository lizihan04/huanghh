                              <Image url="@../../../resources/images/img_ui/ui_hp.png" />
                           </image>
                        </ImageView>
                     </children>
                  </StackPane>
                  <Label layoutY="20.0" prefHeight="30.0" prefWidth="120.0" text="生命值" textAlignment="CENTER" />
                  <StackPane>
                     <children>
                        <ImageView fitHeight="70.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../../../resources/images/img_ui/ui_hunger.png" />
                           </image>
                        </ImageView>
                     </children>
                  </StackPane>
                  <Label prefHeight="30.0" prefWidth="120.0" text="饥饿值" textAlignment="CENTER" />
