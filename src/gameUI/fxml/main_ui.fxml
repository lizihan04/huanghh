                                    <Image url="@../../../resources/images/img_ui/ui_bag.png" />
                                 </image>
                              </ImageView>
                           </children>
                        </StackPane>
                        <StackPane>
                           <children>
                              <Button fx:id="btnBag" mnemonicParsing="false" onAction="#openBagChooseWindow" prefHeight="20.0" prefWidth="60.0" text="背包" />
                           </children>
                        </StackPane>
                     </children>
                  </VBox>
                  <VBox prefHeight="200.0" prefWidth="189.0">
