                  <AnchorPane fx:id="mapDisplayPane" prefHeight="500.0" prefWidth="889.0">
                     <children>
                        <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
                     </children>
