                              <Image url="@../../../resources/images/img_ui/ui_fatigue.png" />
                           </image>
                        </ImageView>
                     </children>
                  </StackPane>
                  <Label prefHeight="30.0" prefWidth="120.0" text="疲惫值" />
                  <StackPane>
                     <children>
                        <ImageView fitHeight="80.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../../../resources/images/img_ui/图片1.png" />
                           </image>
                        </ImageView>
                     </children>
                  </StackPane>
                  <Label prefHeight="30.0" prefWidth="120.0" text="行动点" />
