                     </children>
                  </VBox>
                  <VBox prefHeight="200.0" prefWidth="189.0">
                     <children>
                        <StackPane>
                           <children>
                              <ImageView fitHeight="70.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../../../resources/images/img_ui/图片2.png" />
                                 </image>
                              </ImageView>
                           </children>
                        </StackPane>
                        <StackPane>
                           <children>
                              <Button fx:id="btnNextDay" mnemonicParsing="false" prefHeight="20.0" prefWidth="60.0" text="下一天" />
                           </children>
                        </StackPane>
                     </children>
                  </VBox>
                  <VBox prefHeight="200.0" prefWidth="189.0">
                     <children>
                        <StackPane>
                           <children>
                              <ImageView fitHeight="70.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../../../resources/images/img_ui/图片3.png" />
