<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<AnchorPane prefHeight="400.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gameUI.controller.Rest">
   <children>
      <HBox prefHeight="400.0" prefWidth="400.0">
         <children>
            <StackPane prefWidth="200.0">
               <children>
                  <Button fx:id="rest" mnemonicParsing="false" prefHeight="50.0" prefWidth="100.0" text="REST" textAlignment="CENTER" />
               </children>
            </StackPane>
            <StackPane prefWidth="200.0">
               <children>
                  <Button mnemonicParsing="false" prefHeight="50.0" prefWidth="100.0" text="EAT" />
               </children>
            </StackPane>
         </children>
      </HBox>
   </children>
</AnchorPane>
