<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="260.0" prefWidth="360.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gameUI.controller.Event">
   <children>
      <Label fx:id="words1" layoutX="16.0" layoutY="16.0" prefHeight="30.0" prefWidth="328.0" style="-fx-font-size:16px; -fx-font-weight:bold;" />
      <Label fx:id="words2" layoutX="16.0" layoutY="58.0" prefHeight="120.0" prefWidth="328.0" wrapText="true" />
      <Label fx:id="weaponTip" layoutX="16.0" layoutY="185.0" prefHeight="24.0" prefWidth="328.0" text="请选择武器进行战斗：" visible="false" />
      <HBox fx:id="weaponHolder" layoutX="16.0" layoutY="215.0" spacing="8.0" visible="false">
         <children>
            <Button fx:id="handButton" mnemonicParsing="false" text="徒手" onAction="#handleWeaponSelect" />
            <Button fx:id="axeButton" mnemonicParsing="false" text="斧头" onAction="#handleWeaponSelect" />
            <Button fx:id="shellAxeButton" mnemonicParsing="false" text="贝刃" onAction="#handleWeaponSelect" />
            <Button fx:id="hammerButton" mnemonicParsing="false" text="锤子" onAction="#handleWeaponSelect" />
            <Button fx:id="clubButton" mnemonicParsing="false" text="木棍" onAction="#handleWeaponSelect" />
            <Button fx:id="dirkButton" mnemonicParsing="false" text="石剑" onAction="#handleWeaponSelect" />
         </children>
      </HBox>
   </children>
</AnchorPane>
